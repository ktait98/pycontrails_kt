\contentsline {chapteratlist}{\numberline {5}Development of a Novel Aircraft Plume Modelling Framework}{127}{chapter.5}%
\contentsline {figure}{\numberline {5.1}{\ignorespaces GPAT process flow schematic portraying the input parameters (rhombuses), constituent models (boxes) and flow of data through a range of datasets (cylinders).}}{130}{figure.caption.132}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Schematic representation of GPAT flight trajectories for a four-aircraft formation configuration.}}{140}{figure.caption.137}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Process flow diagram for the Trajectory Model. This model takes in fl\_params and outputs the first generation FL dataset.}}{141}{figure.caption.138}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Process flow diagram for the Meteorological Model. This model takes in parameters that define the simulation domain, and output a gridded MET dataset across all time steps.}}{142}{figure.caption.139}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Process flow diagram for the Background Chemistry Model. This takes in Simulation Parameters to define the simulation domain, and outputs the gridded BG\_CHEM dataset for the initial time step of the modelling environment.}}{143}{figure.caption.140}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Process flow diagram for the Aircraft Performance Model. This takes in the first generation Flight Dataset and Meteorology Dataset, interpolated and down-selected to the trajectory waypoints. It outputs the second generation FL dataset, updated with performance characteristics.}}{144}{figure.caption.141}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Process flow diagram for the Emissions Model. This takes the 2\textsuperscript {nd} gen. FL dataset, calculates emission masses associated with each waypoint, then outputs to PL dataset.}}{145}{figure.caption.143}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces \textbf {(a)} Schematic representation of Gaussian dispersion and advection from GPAT plume simulations. \textbf {(b)} Five slice Gaussian aggregation to 2D Eulerian grid. Gaussian starts at half plume width (W/2).}}{147}{figure.caption.144}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Process flow diagram for the Dispersion/Advection Model. MET is updated by passing plume\_params to it, assigning additional dispersion properties to the dataset. The 2\textsuperscript {nd} gen. MET and FL datasets are passed to the sim\_plumes model which simulates the advection and dispersion of plume waypoints. Plume position and Gaussian dispersion data is then attached to the Plume Dataset.}}{148}{figure.caption.145}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Process flow diagram for the Plume-to-Grid Model. Gaussian plume and emissions data is passed to the model. Following plume aggregation, a 2D gridded Emissions Dataset is generated.}}{150}{figure.caption.150}%
