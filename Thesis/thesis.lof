\contentsline {figure}{\numberline {2.13}{\ignorespaces \textbf {(a)} Example isopleth diagram displaying peak ozone concentrations calculated from various initial concentrations of \ce {NO_x} and a specified VOC mixture, using the US EPA empirical kinetic model \blx@tocontentsinit {0}\cite {Dodge1977, Jenkin2000}. \textbf {(b)} Schematic representation of the variation of net ozone production efficiency with \ce {NO_x} concentrations, with magnitudes reflecting clean free tropospheric conditions (i.e. low VOC/\ce {NO_x} ratio) \blx@tocontentsinit {0}\cite {Monks2005}.}}{59}{figure.caption.58}%
\contentsline {figure}{\numberline {2.14}{\ignorespaces Schematic representation of the OH initiated, \ce {NO_x}-catalysed oxidation scheme for CO and \ce {CH_4} \blx@tocontentsinit {0}\cite {Jenkin2008}.}}{63}{figure.caption.79}%
\contentsline {figure}{\numberline {2.15}{\ignorespaces The microphysical formation of aerosol and contrail particles in an aircraft plume. Displayed as a function of plume age and temperature \blx@tocontentsinit {0}\cite {IPCC1999}.}}{67}{figure.caption.90}%
\contentsline {figure}{\numberline {2.16}{\ignorespaces \textbf {(a)} Daily mean instantaneous SW, LW and net components of RF assuming 100\% contrail cover vs optical depth as calculated using the spherical ice particle model from Schumann et al.\ \blx@tocontentsinit {0}\cite {Schumann2012b}. Results from Meerk{\"o}tter et al.\ \blx@tocontentsinit {0}\cite {Meerkotter1999} shown for comparison. \textbf {(b)} RF vs SZA for spherical ice particles, with Meerk{\"o}tter comparison shown. See \blx@tocontentsinit {0}\cite {Schumann2012b} for more detail on assumed atmospheric conditions.}}{69}{figure.caption.93}%
\contentsline {figure}{\numberline {2.17}{\ignorespaces Empirical observations of ozone production rate as a function of \ce {NO_x} concentrations (parts per trillion volume, pptv), for three ranges of primary \ce {HO_x} production: (a) 20--40~pptv/day, (b) 40--80 pptv/day, and (c) 100--200~pptv/day. Solid lines represent the range limits from model calculations. Dashed lines depict the \ce {NO_x} level that induces peak ozone response \blx@tocontentsinit {0}\cite {Jaegle1999}.}}{72}{figure.caption.96}%
\contentsline {figure}{\numberline {2.18}{\ignorespaces \textbf {(a)} Efficiency gains versus absolute aviation emissions growth since 1940 and projected to 2040 \blx@tocontentsinit {0}\cite {Peeters2016}. \textbf {(b)} IATA Net Zero 2050 contributions \blx@tocontentsinit {0}\cite {IATANetZero}.}}{79}{figure.caption.103}%
