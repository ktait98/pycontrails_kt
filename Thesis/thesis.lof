\contentsline {chapteratlist}{\numberline {2}Aircraft Emissions, their Plume-Scale Effects, and the Spatio-Temporal Sensitivity of the Atmospheric Response}{10}{chapter.2}%
\contentsline {figure}{\numberline {2.1}{\ignorespaces Example log-log plots of EI against fuel flow at reference conditions, as prescribed by the BFFM2. The percentage values refer to the thrust as a percentage of maximum thrust at SLS conditions \blx@tocontentsinit {0}\cite {AIR5715}.}}{21}{figure.caption.16}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Aircraft exhaust plume dynamical regimes. Wake distance behind aircraft $x_w = v_\infty \times t$ where $v_\infty $ is aircraft speed and $t$ is the post emission time \blx@tocontentsinit {0}\cite {Paoli2016, Gerz1998}.}}{24}{figure.caption.19}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Dilution ratio against plume age derived from empirical data. Marker shapes correspond to tracer species as displayed in legend. Markers with error bars correspond to characteristic values for the engine core (leftmost and lower) and bypass exits (rightmost and upper). The dashed curves near the core represent dilution on the jet axis, calculated for two engine types: CFM56 and RB211. The dotted curve represents large eddy simulation results from Gerz and Ehret \blx@tocontentsinit {0}\cite {Gerz1997}. The range of dilution values computed for large plumes ages by D{\"u}rbeck and Gerz \blx@tocontentsinit {0}\cite {Durbeck1996} are bounded by the triangle, top right of the figure. The dash-dotted line shows the interpolation that is represented by equation \eqref {N_equation}. From Schumann et al.\ \blx@tocontentsinit {0}\cite {Schumann1998}.}}{28}{figure.caption.22}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces MP model visual representation \blx@tocontentsinit {0}\cite {Kraabol2000a}. Plume length L was set to the distance travelled over 1 s (247 m in this scenario) with three out of eight concentric rings shown for each time step. $C_1 - C_3$ indicate the concentrations in each ring and the arrows represent mixing between the layers.}}{31}{figure.caption.25}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Evolution of \textbf {(a)} horizontal and \textbf {(b)} vertical plume radius over time, for MP model under assumed turbulent conditions \blx@tocontentsinit {0}\cite {Kraabol2000a}.}}{32}{figure.caption.26}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Aircraft capacity estimation against sector volume for a range of airspace scenarios \blx@tocontentsinit {0}\cite {Welch2007}. }}{38}{figure.caption.39}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Spatial (latitude, longitude and altitude) distribution of global aviation fuel burn from a range of aircraft emissions datasets \blx@tocontentsinit {0}\cite {Olsen2013}.}}{41}{figure.caption.40}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Temporal (diurnal and seasonal) distribution of global aviation fuel burn expressed as percentage from a range of aircraft emissions datasets \blx@tocontentsinit {0}\cite {Olsen2013}.}}{42}{figure.caption.41}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Lateral, longitudinal and vertical maximum plume overlap scenarios, based on nominal separation minima \blx@tocontentsinit {0}\cite {ICAOPANSDoc44442016}}}{44}{figure.caption.42}%
\contentsline {figure}{\numberline {2.10}{\ignorespaces Radiative forcing contributions from global aviation between 2000 and 2018 \blx@tocontentsinit {0}\cite {Lee2021}. Error bars represent 5--95\% confidence interval, with corresponding RF and ERF values shown in parentheses.}}{48}{figure.caption.43}%
\contentsline {figure}{\numberline {2.11}{\ignorespaces Visual representation of contrail radiative forcing, adapted from Karcher et al.\ \blx@tocontentsinit {0}\cite {Karcher2018}.}}{51}{figure.caption.48}%
\contentsline {figure}{\numberline {2.12}{\ignorespaces Schematic overview of climate forcing mechanisms induced by aircraft emissions \blx@tocontentsinit {0}\cite {Lee2021}.}}{56}{figure.caption.55}%
\contentsline {figure}{\numberline {2.13}{\ignorespaces \textbf {(a)} Example isopleth diagram displaying peak ozone concentrations calculated from various initial concentrations of \ce {NO_x} and a specified VOC mixture, using the US EPA empirical kinetic model \blx@tocontentsinit {0}\cite {Dodge1977, Jenkin2000}. \textbf {(b)} Schematic representation of the variation of net ozone production efficiency with \ce {NO_x} concentrations, with magnitudes reflecting clean free tropospheric conditions (i.e. low VOC/\ce {NO_x} ratio) \blx@tocontentsinit {0}\cite {Monks2005}.}}{60}{figure.caption.58}%
\contentsline {figure}{\numberline {2.14}{\ignorespaces Schematic representation of the OH initiated, \ce {NO_x}-catalysed oxidation scheme for CO and \ce {CH_4} \blx@tocontentsinit {0}\cite {Jenkin2008}.}}{64}{figure.caption.79}%
\contentsline {figure}{\numberline {2.15}{\ignorespaces The microphysical formation of aerosol and contrail particles in an aircraft plume. Displayed as a function of plume age and temperature \blx@tocontentsinit {0}\cite {IPCC1999}.}}{68}{figure.caption.90}%
\contentsline {figure}{\numberline {2.16}{\ignorespaces \textbf {(a)} Daily mean instantaneous SW, LW and net components of RF assuming 100\% contrail cover vs optical depth as calculated using the spherical ice particle model from Schumann et al.\ \blx@tocontentsinit {0}\cite {Schumann2012b}. Results from Meerk{\"o}tter et al.\ \blx@tocontentsinit {0}\cite {Meerkotter1999} shown for comparison. \textbf {(b)} RF vs SZA for spherical ice particles, with Meerk{\"o}tter comparison shown. See \blx@tocontentsinit {0}\cite {Schumann2012b} for more detail on assumed atmospheric conditions.}}{70}{figure.caption.93}%
\contentsline {figure}{\numberline {2.17}{\ignorespaces Empirical observations of ozone production rate as a function of \ce {NO_x} concentrations (parts per trillion volume, pptv), for three ranges of primary \ce {HO_x} production: (a) 20--40~pptv/day, (b) 40--80 pptv/day, and (c) 100--200~pptv/day. Solid lines represent the range limits from model calculations. Dashed lines depict the \ce {NO_x} level that induces peak ozone response \blx@tocontentsinit {0}\cite {Jaegle1999}.}}{73}{figure.caption.96}%
\contentsline {figure}{\numberline {2.18}{\ignorespaces \textbf {(a)} Efficiency gains versus absolute aviation emissions growth since 1940 and projected to 2040 \blx@tocontentsinit {0}\cite {Peeters2016}. \textbf {(b)} IATA Net Zero 2050 contributions \blx@tocontentsinit {0}\cite {IATANetZero}.}}{80}{figure.caption.103}%
\contentsline {figure}{\numberline {2.19}{\ignorespaces Schematic representation of contrail avoidance strategy. Plot of cumulative contrail energy forcing against proportion of flights \blx@tocontentsinit {0}\cite {Teoh2020}.}}{83}{figure.caption.106}%
\contentsline {figure}{\numberline {2.20}{\ignorespaces Visual representation of the formation flight concept, depicting the fundamental principles of wake energy retrieval \blx@tocontentsinit {0}\cite {Marks2020}.}}{86}{figure.caption.109}%
